    <string name="about_this_app">About This App</string>
    <string name="about_description">Grading Home-Grown Mushroom Using Deep Learning is an AI-powered mobile application that uses computer vision and machine learning to grade home-grown mushrooms. Simply capture a photo to assess mushroom quality based on cap size, stem length, color uniformity, and overall appearance.</string>
    <string name="technical_details_title">Technical Details</string>
    <string name="technical_details">• YOLOv8 Object Detection\n• TensorFlow Lite Model\n• Real-time Image Processing\n• Supports Oyster, Shiitake, and Button Mushrooms\n• Minimum 8MP Camera Required</string>
    <string name="credits_title">Developers</string>
    <string name="app_credits">Ayana Jade F. Alejo\nAlfaith Mae M. Luzon\nJustine Jose B. Salvador\n\nAdviser: Jaydee C. Ballaho, MIT\n\nWestern Mindanao State University\nCollege of Computing Studies\nDepartment of Computer Science</string>
    <string name="disclaimer_title">Disclaimer</string>
    <string name="app_disclaimer">This application is developed for educational and research purposes as part of a thesis project. It is intended for small-scale home-based mushroom grading and should not replace expert judgment for commercial operations. Always verify mushroom safety with qualified experts before consumption.</string>
