<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sky background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EFF6FF"/>
        </shape>
    </item>

    <!-- Table -->
    <item android:gravity="bottom" android:height="78dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <stroke android:width="1dp" android:color="#EEF0F4"/>
        </shape>
    </item>

    <!-- Window frame (3D) -->
    <item
        android:width="142dp"
        android:height="112dp"
        android:gravity="top|center_horizontal"
        android:top="14dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#FFFFFFFF" android:endColor="#FFEAF2FF"/>
            <stroke android:width="2dp" android:color="#BFDBFE"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- Inner window shade -->
    <item
        android:width="136dp"
        android:height="106dp"
        android:gravity="top|center_horizontal"
        android:top="17dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#FFE0F2FE" android:endColor="#FF93C5FD"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>

    <!-- Dividers -->
    <item android:width="2dp" android:height="104dp" android:gravity="top|center_horizontal" android:top="18dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFF"/></shape>
    </item>
    <item android:width="136dp" android:height="2dp" android:gravity="top|center_horizontal" android:top="70dp">
        <shape android:shape="rectangle"><solid android:color="#FFFFFF"/></shape>
    </item>

    <!-- Soft rays -->
    <item android:gravity="top|center_horizontal" android:top="128dp" android:left="-42dp" android:width="14dp" android:height="100dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#00FBBF24" android:centerColor="#33FBBF24" android:endColor="#00FBBF24"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:gravity="top|center_horizontal" android:top="122dp" android:width="16dp" android:height="112dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#00FBBF24" android:centerColor="#40FBBF24" android:endColor="#00FBBF24"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item android:gravity="top|center_horizontal" android:top="128dp" android:left="42dp" android:width="14dp" android:height="100dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#00FBBF24" android:centerColor="#33FBBF24" android:endColor="#00FBBF24"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>

    <!-- Mushroom shadow -->
    <item android:width="140dp" android:height="22dp" android:gravity="bottom|center_horizontal" android:bottom="26dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="90dp" android:startColor="#240F172A" android:endColor="#000F172A"/>
        </shape>
    </item>

    <!-- Stem -->
    <item android:width="36dp" android:height="48dp" android:gravity="bottom|center_horizontal" android:bottom="30dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FFF3E7D3" android:endColor="#FFE6D4B8"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <!-- Cap -->
    <item android:width="118dp" android:height="70dp" android:gravity="bottom|center_horizontal" android:bottom="58dp">
        <shape android:shape="oval">
            <gradient android:angle="90" android:startColor="#FFF59E0B" android:endColor="#FFD97706"/>
        </shape>
    </item>

    <!-- Cap highlight -->
    <item android:width="86dp" android:height="40dp" android:gravity="bottom|center_horizontal" android:bottom="76dp" android:left="14dp">
        <shape android:shape="oval">
            <gradient android:angle="90" android:startColor="#30FFFFFF" android:endColor="#00FFFFFF"/>
        </shape>
    </item>

</layer-list>
